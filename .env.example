# URL base da API do backend (SaaS Hotel).
# Sem esta variável, o app usa http://localhost:8080.
# Em produção, defina a URL pública, ex.:
# VITE_API_BASE_URL=https://saas-hotel-istoepousada-dc98593a88fc.herokuapp.com
VITE_API_BASE_URL=

# Número de WhatsApp (com código do país, só dígitos) para contato/redirect.
# Sem esta variável, o app usa 5598988555038.
# Ex.: VITE_WHATSAPP_NUMBER=5598988555038
VITE_WHATSAPP_NUMBER=
